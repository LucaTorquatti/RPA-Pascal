program problema172;
 var patente: char; i: integer;

 begin
       for i:= 1 to 3 do begin
           read(patente);
            writeln('primer for1', patente);
         end;

       for i:= 1 to 3 do begin
            writeln('primer for2', patente);
         end;
       readln;

       readln;
 end.

